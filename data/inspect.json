   "id": "eng-number",
   "area": "Engine",
   "check": "Engine number",
   "how": "Lift the plastic cover. Read the number on top of the block at the front right. Later than 18 August 2000 is steel lined. A number from that day itself is not confirmed either way. Look for an exchange plate.",
   "bad": "Earlier number with no replacement record.",
   "cost": null,
   "weakspot": "nikasil",
