  {
   "id": "papers-recalls",
   "area": "Paperwork",
   "check": "Recalls and service actions",
   "how": "Ask for invoices or a dealer printout showing the Jaguar recall work was done. The numbers to look for, as they apply: S514, S498, R466, R478, S474 and S484. The car cannot show this and neither can this app. A Jaguar dealer or specialist can check by VIN.",
   "bad": "No record on a car in range.",
   "cost": null,
   "weakspot": "throttle-body-early",
   "appliesTo": {
    "myTo": 2002
   },
